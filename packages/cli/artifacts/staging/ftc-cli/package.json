{
  "name": "@ftc-dev-tools/cli",
  "version": "0.1.0",
  "description": "Command-line tool for FTC Android robot projects",
  "license": "Apache-2.0",
  "author": {
    "name": "The Allsparks contributors",
    "url": "https://github.com/The-Allsparks"
  },
  "homepage": "https://www.theallsparks.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Allsparks/ftc-dev-tools.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/The-Allsparks/ftc-dev-tools/issues"
  },
  "type": "module",
  "bin": {
    "ftc": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node --input-type=module -e \"import fs from 'node:fs'; fs.rmSync('dist',{recursive:true,force:true});\"",
    "package": "npm run build && node ./scripts/package-cli.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ftc-dev-tools/shared": "0.1.0",
    "commander": "^13.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}

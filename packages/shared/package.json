{
  "name": "@ftc-dev-tools/shared",
  "version": "0.1.0",
  "description": "Shared TypeScript services for FTC Dev Tools CLI, VS Code extension, and MCP server",
  "license": "Apache-2.0",
  "author": {
    "name": "The Allsparks contributors",
    "url": "https://github.com/The-Allsparks"
  },
  "homepage": "https://www.theallsparks.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Allsparks/ftc-dev-tools.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/The-Allsparks/ftc-dev-tools/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/ftc-dev.schema.json": "./schemas/ftc-dev.schema.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node --input-type=module -e \"import fs from 'node:fs'; fs.rmSync('dist',{recursive:true,force:true});\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}

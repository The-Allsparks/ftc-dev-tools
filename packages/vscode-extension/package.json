{
  "name": "ftc-dev-tools",
  "displayName": "FTC Dev Tools",
  "description": "Build, deploy, and diagnose FIRST Tech Challenge Android robot projects from VS Code or Cursor. Created by The Allsparks for our team and the wider FTC community.",
  "version": "0.1.0",
  "publisher": "ftc-dev-tools",
  "license": "Apache-2.0",
  "author": {
    "name": "The Allsparks contributors",
    "url": "https://github.com/The-Allsparks"
  },
  "homepage": "https://www.theallsparks.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Allsparks/ftc-dev-tools.git",
    "directory": "packages/vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/The-Allsparks/ftc-dev-tools/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionDependencies": [
    "vscode.github-authentication"
  ],
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onCommand:ftc.startHere",
    "workspaceContains:settings.gradle",
    "workspaceContains:settings.gradle.kts",
    "workspaceContains:.ftc-dev.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ftc.startHere",
        "title": "FTC: Start Here",
        "category": "FTC"
      },
      {
        "command": "ftc.runDoctor",
        "title": "FTC: Run Environment Check"
      },
      {
        "command": "ftc.connectRobotUsb",
        "title": "FTC: Connect My Robot (USB First)"
      },
      {
        "command": "ftc.firstOpModeJourney",
        "title": "FTC: First OpMode Journey"
      },
      {
        "command": "ftc.openDeviceConnectionsDoc",
        "title": "FTC: Open Device Connections Guide"
      },
      {
        "command": "ftc.markOpModeOnDriverStation",
        "title": "FTC: Mark OpMode on Driver Station"
      },
      {
        "command": "ftc.resetCompetitionChecklist",
        "title": "FTC: Reset Competition Readiness Checklist"
      },
      {
        "command": "ftc.showDevices",
        "title": "FTC: Show Devices"
      },
      {
        "command": "ftc.build",
        "title": "FTC: Build Robot Code"
      },
      {
        "command": "ftc.deploy",
        "title": "FTC: Deploy to Robot"
      },
      {
        "command": "ftc.buildAndDeploy",
        "title": "FTC: Build and Deploy"
      },
      {
        "command": "ftc.selectDevice",
        "title": "FTC: Select Deployment Device"
      },
      {
        "command": "ftc.viewLogs",
        "title": "FTC: View Robot Logs"
      },
      {
        "command": "ftc.viewErrorLogs",
        "title": "FTC: View Error Logs"
      },
      {
        "command": "ftc.stopLogs",
        "title": "FTC: Stop Robot Logs"
      },
      {
        "command": "ftc.clean",
        "title": "FTC: Clean Project"
      },
      {
        "command": "ftc.checkSdk",
        "title": "FTC: Check SDK Version"
      },
      {
        "command": "ftc.updateSdk",
        "title": "FTC: Update FTC SDK"
      },
      {
        "command": "ftc.wifiStatus",
        "title": "FTC: Wi-Fi Status"
      },
      {
        "command": "ftc.wifiSelectInterface",
        "title": "FTC: Select Robot Network Interface"
      },
      {
        "command": "ftc.wifiEnsureRoute",
        "title": "FTC: Ensure Robot Network Route"
      },
      {
        "command": "ftc.wifiConnect",
        "title": "FTC: Connect Wi-Fi ADB"
      },
      {
        "command": "ftc.wifiDisconnect",
        "title": "FTC: Disconnect Wi-Fi ADB"
      },
      {
        "command": "ftc.wifiOpenConsole",
        "title": "FTC: Open Robot Controller Console"
      },
      {
        "command": "ftc.openFtcDashboard",
        "title": "FTC: Open FTC Dashboard"
      },
      {
        "command": "ftc.openVisionLab",
        "title": "FTC: Open Vision Lab",
        "category": "FTC"
      },
      {
        "command": "ftc.visionRefresh",
        "title": "FTC: Refresh Vision Lab",
        "category": "FTC",
        "icon": "$(refresh)"
      },
      {
        "command": "ftc.visionOpenSource",
        "title": "FTC: Open Vision Source File",
        "category": "FTC"
      },
      {
        "command": "ftc.wifiJoin",
        "title": "FTC: Join Robot Wi-Fi"
      },
      {
        "command": "ftc.wifiManageGet",
        "title": "FTC: Get Hub Wi-Fi Settings"
      },
      {
        "command": "ftc.wifiManageSet",
        "title": "FTC: Manage Hub Wi-Fi"
      },
      {
        "command": "ftc.wifiPreferInternet",
        "title": "FTC: Prefer Internet Interface"
      },
      {
        "command": "ftc.wifiPreferRobot",
        "title": "FTC: Prefer Robot Interface"
      },
      {
        "command": "ftc.wifiAdapterEnable",
        "title": "FTC: Enable Network Adapter"
      },
      {
        "command": "ftc.wifiAdapterDisable",
        "title": "FTC: Disable Network Adapter"
      },
      {
        "command": "ftc.hubStatus",
        "title": "FTC: Control Hub Status"
      },
      {
        "command": "ftc.hubUpdateCheck",
        "title": "FTC: Check Control Hub OS Update"
      },
      {
        "command": "ftc.hubUpdateDownload",
        "title": "FTC: Download Control Hub OS"
      },
      {
        "command": "ftc.hubUpdateApply",
        "title": "FTC: Apply Control Hub OS Update"
      },
      {
        "command": "ftc.pedroStatus",
        "title": "FTC: Pedro Pathing Status"
      },
      {
        "command": "ftc.pedroAdd",
        "title": "FTC: Add Pedro Pathing"
      },
      {
        "command": "ftc.pedroScaffold",
        "title": "FTC: Scaffold Pedro Pathing"
      },
      {
        "command": "ftc.opmodeList",
        "title": "FTC: List OpModes"
      },
      {
        "command": "ftc.opmodeCreate",
        "title": "FTC: Create OpMode"
      },
      {
        "command": "ftc.configList",
        "title": "FTC: List Robot Configs"
      },
      {
        "command": "ftc.configShow",
        "title": "FTC: Show Robot Config"
      },
      {
        "command": "ftc.configValidate",
        "title": "FTC: Validate Robot Config"
      },
      {
        "command": "ftc.configPull",
        "title": "FTC: Pull Robot Configs"
      },
      {
        "command": "ftc.hwmapShow",
        "title": "FTC: Show Hardware Map"
      },
      {
        "command": "ftc.hwmapCodegen",
        "title": "FTC: Generate OpMode from Config"
      },
      {
        "command": "ftc.configureRecommendedExtensions",
        "title": "FTC: Configure Recommended Extensions"
      },
      {
        "command": "ftc.setUpComputer",
        "title": "FTC: Set Up This Computer"
      },
      {
        "command": "ftc.runInstallDeps",
        "title": "FTC: Run Trusted Install-Deps Installer"
      },
      {
        "command": "ftc.obtainProject",
        "title": "FTC: Get or Open FTC Project"
      },
      {
        "command": "ftc.setUpProject",
        "title": "FTC: Set Up This FTC Project"
      },
      {
        "command": "ftc.restoreProjectSetup",
        "title": "FTC: Restore Project Setup Backup"
      },
      {
        "command": "ftc.selectProjectRoot",
        "title": "FTC: Select Project Root"
      },
      {
        "command": "ftc.openSuggestedProjectRoot",
        "title": "FTC: Open Correct Project Root"
      },
      {
        "command": "ftc.addSuggestedProjectRootToWorkspace",
        "title": "FTC: Add Project Root to Workspace"
      },
      {
        "command": "ftc.installCli",
        "title": "FTC: Install FTC CLI"
      },
      {
        "command": "ftc.linkGitHubForReports",
        "title": "FTC: Link GitHub for Error Reports"
      },
      {
        "command": "ftc.unlinkGitHubForReports",
        "title": "FTC: Unlink GitHub Error Reports"
      },
      {
        "command": "ftc.openTechnicalOutput",
        "title": "FTC: Open Technical Output"
      },
      {
        "command": "ftc.refreshView",
        "title": "FTC: Refresh View"
      }
    ],
    "walkthroughs": [
      {
        "id": "ftc.rookieOnboarding",
        "title": "Get started with FTC Dev Tools",
        "description": "Prepare your computer, open an FTC project, connect the robot, and run your first OpMode from VS Code or Cursor.",
        "when": "!isWeb",
        "steps": [
          {
            "id": "start-here",
            "title": "Open the guided checklist",
            "description": "Start Here tracks progress in a checklist doc and panel so you can pause and resume anytime.",
            "media": {
              "markdown": "Run [FTC: Start Here](command:ftc.startHere) from the Command Palette.\n\nOpen the **FTC** activity bar for the robot sidebar."
            },
            "completionEvents": [
              "onCommand:ftc.startHere"
            ]
          },
          {
            "id": "prepare-computer",
            "title": "Prepare this computer",
            "description": "Install only what is missing: JDK, Android platform-tools, and recommended extensions — you approve each step.",
            "media": {
              "markdown": "Run [FTC: Set Up This Computer](command:ftc.setUpComputer), then [FTC: Run Environment Check](command:ftc.runDoctor) to confirm Java and adb."
            },
            "completionEvents": [
              "onCommand:ftc.setUpComputer",
              "onCommand:ftc.runDoctor"
            ]
          },
          {
            "id": "open-project",
            "title": "Get or open your FTC project",
            "description": "Open the Android Studio project folder (settings.gradle + TeamCode) or clone your team repo / the official SDK template.",
            "media": {
              "markdown": "Run [FTC: Get or Open FTC Project](command:ftc.obtainProject), then [FTC: Set Up This FTC Project](command:ftc.setUpProject) for tasks and settings."
            },
            "completionEvents": [
              "onCommand:ftc.obtainProject",
              "onCommand:ftc.setUpProject"
            ]
          },
          {
            "id": "connect-robot",
            "title": "Connect the robot (USB first)",
            "description": "Plug in USB, authorize debugging on the robot, and pick which device receives deploys.",
            "media": {
              "image": "media/ftc.svg",
              "altText": "FTC Dev Tools icon — replace with robot connection screenshot when available"
            },
            "completionEvents": [
              "onCommand:ftc.connectRobotUsb"
            ]
          },
          {
            "id": "first-opmode",
            "title": "Run your first OpMode",
            "description": "Create a simple TeleOp, deploy, and use Driver Station Init and Start.",
            "media": {
              "markdown": "Run [FTC: First OpMode Journey](command:ftc.firstOpModeJourney) for a narrated path, or [FTC: Create OpMode](command:ftc.opmodeCreate) on your own."
            },
            "completionEvents": [
              "onCommand:ftc.firstOpModeJourney",
              "onCommand:ftc.opmodeCreate"
            ]
          },
          {
            "id": "build-deploy",
            "title": "Build and deploy",
            "description": "Compile TeamCode and install the APK on the device you selected.",
            "media": {
              "markdown": "Run [FTC: Build and Deploy](command:ftc.buildAndDeploy), or build and deploy separately with [FTC: Build Robot Code](command:ftc.build) and [FTC: Deploy to Robot](command:ftc.deploy)."
            },
            "completionEvents": [
              "onCommand:ftc.buildAndDeploy",
              "onCommand:ftc.deploy"
            ]
          },
          {
            "id": "view-logs",
            "title": "View robot logs",
            "description": "Stream TeamCode logcat while testing on Driver Station to catch runtime errors early.",
            "media": {
              "markdown": "Run [FTC: View Robot Logs](command:ftc.viewLogs). Stop streaming with [FTC: Stop Robot Logs](command:ftc.stopLogs) when finished."
            },
            "completionEvents": [
              "onCommand:ftc.viewLogs"
            ]
          }
        ]
      }
    ],
    "snippets": [
      {
        "language": "java",
        "path": "./snippets/ftc-java.code-snippets"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ftcDevTools",
          "title": "FTC",
          "icon": "media/ftc.svg"
        }
      ],
      "panel": [
        {
          "id": "ftcStartHerePanel",
          "title": "FTC Start Here",
          "icon": "media/ftc.svg"
        }
      ]
    },
    "views": {
      "ftcDevTools": [
        {
          "id": "ftc.robotView",
          "name": "FTC Robot"
        },
        {
          "type": "webview",
          "id": "ftc.visionSidebar",
          "name": "Vision"
        }
      ],
      "ftcStartHerePanel": [
        {
          "type": "webview",
          "id": "ftc.startHereDock",
          "name": "Checklist"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "ftc.refreshView",
          "when": "view == ftc.robotView",
          "group": "navigation"
        },
        {
          "command": "ftc.visionRefresh",
          "when": "view == ftc.visionSidebar",
          "group": "navigation"
        },
        {
          "command": "ftc.openVisionLab",
          "when": "view == ftc.visionSidebar",
          "group": "navigation"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "ftc-dev-tools",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "build",
              "deploy",
              "buildAndDeploy"
            ],
            "description": "FTC Dev Tools command to run (same as Command Palette entries)."
          }
        }
      }
    ],
    "configuration": {
      "title": "FTC Dev Tools",
      "properties": {
        "ftc.preferredDeviceSerial": {
          "type": "string",
          "default": "",
          "description": "Local preferred Android device serial for deployment. Machine-local; not a team secret."
        },
        "ftc.robotNetworkInterface": {
          "type": "string",
          "default": "",
          "description": "Network interface name used for Control Hub / robot Wi-Fi traffic in dual-NIC setups."
        },
        "ftc.projectRoot": {
          "type": "string",
          "default": "",
          "description": "Optional override for the FTC Android Studio project root (folder with settings.gradle and TeamCode). Aligns with the FTC_PROJECT_ROOT environment variable used by the MCP server when set."
        },
        "ftc.autoReportErrors": {
          "type": "boolean",
          "default": false,
          "description": "When GitHub is linked, automatically file or update error report issues on command failures (same title dedupes to comments)."
        },
        "ftc.javaHome": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Machine-local path to JDK 17 for Gradle builds (overrides PATH). Stored in user settings; also honored via FTC_JAVA_HOME. Example: C:\\Program Files\\Eclipse Adoptium\\jdk-17.0.13.11-hotspot"
        }
      }
    }
  },
  "scripts": {
    "build": "node ./esbuild.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "package": "npm run build && node ./scripts/package-vsix.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ftc-dev-tools/shared": "0.1.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.28.1"
  }
}
